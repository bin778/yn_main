# 상담 접수 API (카페24 PHP). 비우면 제출 시 안내 스텁만 표시됩니다.
#
# Vercel·로컬 dev (same-origin, CORS 불필요 — next.config rewrite → 카페24 /api/submit_inquiry.php):
NEXT_PUBLIC_INQUIRY_API_URL=/api/submit_inquiry.php
#
# /backend/api/submit_inquiry.php 도 rewrite alias 지원 (동일 동작)
# NEXT_PUBLIC_INQUIRY_API_URL=/backend/api/submit_inquiry.php
#
# 카페24 정적 호스팅만 쓸 때 (cross-origin, PHP $allowed_origins에 Origin 등록 필요):
# NEXT_PUBLIC_INQUIRY_API_URL=https://yeoon.co.kr/api/submit_inquiry.php

# 게시판 API (카페24 PHP, 서버사이드 전용 — NEXT_PUBLIC 불필요).
BOARD_API_URL=https://yeoon.co.kr/api/board

# Google Analytics 4 측정 ID. 비우면 직접 gtag GA4를 로드하지 않습니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ML3C4J7WDE

# Google Tag Manager 컨테이너 ID (GTM-XXXX). 비우면 GTM을 로드하지 않습니다.
# 동의 후 dataLayer로 generate_lead(inflow_url 포함) 등 이벤트가 전달됩니다.
NEXT_PUBLIC_GTM_ID=GTM-W24G2LD8

# 네이버 지도 Dynamic Map Client ID (NCP Application). Client Secret은 넣지 마세요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=cgkhihcz6p