# 상담 접수 API (카페24 PHP). 비우면 제출 시 안내 스텁만 표시됩니다.
#
# Vercel·로컬 dev (same-origin, CORS 불필요 — next.config rewrite로 카페24 프록시):
NEXT_PUBLIC_INQUIRY_API_URL=/backend/api/submit_inquiry.php
#
# 카페24 정적 호스팅만 쓸 때 (cross-origin, PHP $allowed_origins에 Origin 등록 필요):
# NEXT_PUBLIC_INQUIRY_API_URL=https://yeoon.co.kr/backend/api/submit_inquiry.php

# 게시판 API (카페24 PHP, 서버사이드 전용 — NEXT_PUBLIC 불필요).
BOARD_API_URL=https://yeoon.co.kr/api/board

# Google Analytics 4 측정 ID. 비우면 GA4 스크립트를 로드하지 않습니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ML3C4J7WDE
