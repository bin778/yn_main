<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- [1. SEO 301 영구 리다이렉트] ---
  RewriteCond %{QUERY_STRING} ^p=(\d+)$ [NC]
  RewriteRule ^peoples\.php$ /people/%1/? [R=301,L]

  RewriteRule ^about\.php$ /about/ [R=301,L]
  RewriteRule ^people\.php$ /people/ [R=301,L]
  RewriteRule ^field\.php$ /field/ [R=301,L]
  RewriteRule ^contact\.php$ /contact/ [R=301,L]
  RewriteRule ^privacy\.php$ /privacy/ [R=301,L]

  # --- [2. 시스템 경로 보호: config 폴더 접근 원천 차단] ---
  RewriteRule ^config/ - [F,L]

  # --- [3. 시스템 경로 보호: API 및 게시판 유지] ---
  RewriteRule ^api/ - [L]
  RewriteRule ^board/ - [L]

  # --- [4. Next.js 정적 파일 및 라우팅 규칙] ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>