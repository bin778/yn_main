<IfModule mod_headers.c>
  # 이미지, 폰트 파일 1년 캐시 유지 (불변)
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Next.js에서 빌드된 정적 JS, CSS 파일 캐시 유지
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- [1. SEO 301 영구 리다이렉트: 레거시 PHP 페이지] ---
  RewriteCond %{QUERY_STRING} ^p=(\d+)$ [NC]
  RewriteRule ^peoples\.php$ /people/%1/? [R=301,L]

  RewriteRule ^about\.php$ /about/ [R=301,L]
  RewriteRule ^people\.php$ /people/ [R=301,L]
  RewriteRule ^field\.php$ /field/ [R=301,L]
  RewriteRule ^contact\.php$ /contact/ [R=301,L]
  RewriteRule ^privacy\.php$ /privacy/ [R=301,L]

  # --- [2. SEO 301 영구 리다이렉트: 구 그누보드 게시판 URL → 신 Next.js 경로] ---
  RewriteCond %{QUERY_STRING} bo_table=success&wr_id=(\d+)
  RewriteRule ^board/bbs/board\.php$ /success-story/%1/? [R=301,L]

  RewriteCond %{QUERY_STRING} ^bo_table=success$
  RewriteRule ^board/bbs/board\.php$ /success-story/? [R=301,L]

  RewriteCond %{QUERY_STRING} bo_table=(review|column|news)
  RewriteCond %{QUERY_STRING} wr_id=(\d+)
  RewriteRule ^board/bbs/board\.php$ /%1/%2/? [R=301,L]

  RewriteCond %{QUERY_STRING} ^bo_table=(review|column|news)$
  RewriteRule ^board/bbs/board\.php$ /%1/? [R=301,L]

  # --- [3. 시스템 경로 보호: 민감 경로 웹 접근 차단] ---
  # 레거시 그누보드 관리자 — Next /admin/ (JWT)만 사용
  RewriteRule ^board/adm(/.*)?$ - [F,L]
  RewriteRule ^board/install(/.*)?$ - [F,L]
  RewriteRule ^dbpma(/.*)?$ - [F,L]
  RewriteRule ^config/ - [F,L]
  RewriteRule ^lib/ - [F,L]

  # --- [4. 시스템 경로 보호: API 및 게시판 공개·데이터 경로 유지] ---
  RewriteRule ^api/ - [L]
  RewriteRule ^board/ - [L]

  # --- [5. Next.js 정적 파일 및 라우팅 규칙] ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>