<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- [1. SEO 301 영구 리다이렉트: 레거시 PHP 페이지] ---
  RewriteCond %{QUERY_STRING} ^p=(\d+)$ [NC]
  RewriteRule ^peoples\.php$ /people/%1/? [R=301,L]

  RewriteRule ^about\.php$ /about/ [R=301,L]
  RewriteRule ^people\.php$ /people/ [R=301,L]
  RewriteRule ^field\.php$ /field/ [R=301,L]
  RewriteRule ^contact\.php$ /contact/ [R=301,L]
  RewriteRule ^privacy\.php$ /privacy/ [R=301,L]

  # --- [2. SEO 301 영구 리다이렉트: 구 그누보드 게시판 URL → 신 Next.js 경로] ---
  # 반드시 [3]의 ^board/ - [L] 규칙보다 먼저 선언해야 리다이렉트가 작동한다.
  #
  # 상세 페이지 (bo_table + wr_id 모두 있는 경우)
  # %1 = bo_table 값, %2 = wr_id 값
  RewriteCond %{QUERY_STRING} bo_table=(review|success|column|news)
  RewriteCond %{QUERY_STRING} wr_id=(\d+)
  RewriteRule ^board/bbs/board\.php$ /%1/%2/? [R=301,L]

  # 목록 페이지 (bo_table만 있는 경우)
  # %1 = bo_table 값
  RewriteCond %{QUERY_STRING} ^bo_table=(review|success|column|news)$
  RewriteRule ^board/bbs/board\.php$ /%1/? [R=301,L]

  # --- [3. 시스템 경로 보호: config 폴더 접근 원천 차단] ---
  RewriteRule ^config/ - [F,L]

  # --- [4. 시스템 경로 보호: API 및 게시판 쓰기/관리 기능 유지] ---
  RewriteRule ^api/ - [L]
  RewriteRule ^board/ - [L]

  # --- [5. Next.js 정적 파일 및 라우팅 규칙] ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>