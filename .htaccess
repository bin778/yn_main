<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- [SEO 301 영구 리다이렉트 (기존 PHP -> Next.js 경로)] ---
  # 쿼리 파라미터가 포함된 요청 처리 (/peoples.php?p=123 -> /people/123/)
  RewriteCond %{QUERY_STRING} ^p=(\d+)$ [NC]
  RewriteRule ^peoples\.php$ /people/%1/? [R=301,L]

  # 일반 페이지 리다이렉트 (PHP -> Next.js 경로)
  RewriteRule ^people\.php$ /people/ [R=301,L]
  RewriteRule ^field\.php$ /field/ [R=301,L]
  RewriteRule ^contact\.php$ /contact/ [R=301,L]
  RewriteRule ^privacy\.php$ /privacy/ [R=301,L]
  # -------------------------------------------------------

  # --- [시스템 경로 보호: API 및 게시판 유지] ---
  # /api/ 폴더로 시작하는 요청과 /board/ 폴더로 시작하는 요청은
  # Next.js 라우팅 규칙에 걸리지 않도록 여기서 처리를 멈춤 (L = Last)
  RewriteRule ^api/ - [L]
  RewriteRule ^board/ - [L]

  # --- [Next.js 정적 파일 및 라우팅 규칙] ---
  # 파일이나 디렉토리가 실제 존재하면 그것을 보여줌
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # .html 확장자를 숨기고 Next.js의 동적 라우팅을 지원하기 위한 규칙
  # (예: /about 요청이 들어오면 /about.html 파일이 있는지 확인)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>